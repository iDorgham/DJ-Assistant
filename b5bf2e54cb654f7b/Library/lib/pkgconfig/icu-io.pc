prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: icu-io
Description: International Components for Unicode: Stream and I/O Library
Version: 78.3
Requires: icu-uc icu-i18n
Requires.private: icu-i18n
Libs: -L${libdir} -licuio
Cflags: -I${includedir}
