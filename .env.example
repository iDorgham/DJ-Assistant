# DJ Assistant Local Development Environment

# Fastify Cloud Control Plane
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Optional Postgres & Redis (for cloud features)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dj_assistant
# REDIS_URL=redis://localhost:6379

# Desktop Configuration
VITE_API_BASE_URL=http://localhost:3001

# Analysis engine (crates/analysis)
# Override the ONNX models directory. Resolution order when unset:
# ./models → <exe_dir>/models → caller fallback. Must exist to take effect.
# DJ_ASSISTANT_MODELS_DIR=/absolute/path/to/models
