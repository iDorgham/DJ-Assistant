# DJ Assistant Local Development Environment

# Fastify Cloud Control Plane
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Optional Postgres & Redis (for cloud features)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dj_assistant
# REDIS_URL=redis://localhost:6379

# Desktop Configuration
VITE_API_BASE_URL=http://localhost:3001

# Analysis engine (crates/analysis)
# Override the ONNX models directory. Resolution order when unset:
# ./models → <exe_dir>/models → caller fallback. Must exist to take effect.
# DJ_ASSISTANT_MODELS_DIR=/absolute/path/to/models

# Spotify Playlist Export (post-MVP)
# Optional PUBLIC OAuth client ID embedded at build time for Authorization Code
# + PKCE. There is NO client secret (PKCE public client). The redirect URI
# (loopback http://127.0.0.1:<port>/callback or a custom URI scheme) must be
# allow-listed in the Spotify developer dashboard.
# SPOTIFY_CLIENT_ID=

# Post-MVP discovery & enrichment providers (all opt-in; nothing is called
# unless the DJ enables the source — the shipped foundations need no network).
# MusicBrainz needs no key (1 req/s limit); iTunes Search and Deezer reads need
# no auth; Discogs needs a personal token; Last.fm and AcoustID need free keys.
# LASTFM_API_KEY=
# DISCOGS_TOKEN=
# ACOUSTID_API_KEY=
# Deezer export (TX.2, OAuth for writes) reuses the desktop PKCE pattern when
# its client ID exists:
# DEEZER_APP_ID=
