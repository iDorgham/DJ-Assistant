# Normalize line endings for cross-platform CI (Windows + macOS runners).
* text=auto eol=lf

# Shell scripts and workflow YAML must keep LF.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

# Binary assets — never normalize.
*.png binary
*.ico binary
*.icns binary
*.onnx binary
*.wav binary
*.flac binary
*.aiff binary
*.aif binary
*.mp3 binary
*.db binary
